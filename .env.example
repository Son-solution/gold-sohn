# ---------------------------------------------------------------
# Gold Sohn – environment variables
# Copy this file to .env.local (never commit .env.local).
# Everything is optional: without values the site runs with
# clearly labelled demo prices and forms that honestly report
# "Online-Versand noch nicht eingerichtet".
# ---------------------------------------------------------------

# Public base URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only "production" allows search engines to index the site.
# Leave empty for local development and Vercel previews.
NEXT_PUBLIC_SITE_ENV=

# --- Live prices (lib/prices/provider.ts) ----------------------
# "swissquote" = purchase prices from the public Swissquote spot feed
# minus the margins in lib/prices/swissquote.ts (no key needed).
PRICE_SOURCE=
# Alternative: endpoint returning purchase prices in the PriceSnapshot JSON shape.
PRICE_API_URL=
# Sent as "Authorization: Bearer <key>" – server side only.
PRICE_API_KEY=

# --- Form delivery (lib/forms/delivery.ts) – choose ONE --------
# Option A: Resend (https://resend.com)
RESEND_API_KEY=
FORM_MAIL_FROM="Gold Sohn Website <anfragen@gold-sohn.de>"
FORM_MAIL_TO=info@gold-sohn.de

# Option B: Webhook (Make, Zapier, n8n, CRM, own backend)
FORM_WEBHOOK_URL=
FORM_WEBHOOK_SECRET=
